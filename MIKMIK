<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>For Mikyla B — March 25, 2026</title>
  <style>
    :root {
      --bg-page: #eef5fc;
      --bg-card: #ffffff;
      --bg-soft: #dcebfa;
      --bg-deep: #14365d;
      --bg-deep-hover: #1d497a;
      --text-main: #10263f;
      --text-muted: #436182;
      --text-light: #f4f9ff;
      --border-soft: #bdd6ee;
      --accent: #2563a8;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-page);
      color: var(--text-main);
      line-height: 1.6;
      padding: 20px 14px 48px;
    }

    .container {
      max-width: 680px;
      margin: 0 auto;
    }

    .card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-soft);
      border-radius: 16px;
      padding: 22px;
      margin-bottom: 18px;
    }

    .cover-box {
      background-color: var(--bg-deep);
      color: var(--text-light);
      border-radius: 18px;
      padding: 32px 22px;
      text-align: center;
      margin-bottom: 18px;
    }

    .cover-date {
      font-size: 0.9rem;
      color: #b7d7f7;
      margin-bottom: 10px;
    }

    .cover-title {
      font-size: 1.85rem;
      font-weight: 700;
      margin-bottom: 10px;
      color: var(--text-light);
    }

    .cover-sub {
      font-size: 1rem;
      color: #dcebfa;
      margin-bottom: 22px;
    }

    .btn {
      display: inline-block;
      background-color: var(--bg-deep);
      color: var(--text-light);
      border: 1px solid var(--bg-deep);
      border-radius: 10px;
      padding: 11px 18px;
      font-size: 0.96rem;
      font-weight: 600;
      cursor: pointer;
      text-decoration: none;
    }

    .btn:hover {
      background-color: var(--bg-deep-hover);
    }

    .cover-box .btn {
      background-color: #dcebfa;
      color: var(--bg-deep);
      border-color: #dcebfa;
    }

    .cover-box .btn:hover {
      background-color: #c7e0f7;
    }

    .btn-secondary {
      background-color: var(--bg-soft);
      color: var(--text-main);
      border: 1px solid var(--border-soft);
    }

    .btn-secondary:hover {
      background-color: #c9dff4;
    }

    .step-section {
      display: none;
    }

    .step-section.active {
      display: block;
    }

    .section-label {
      font-size: 0.8rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--accent);
      margin-bottom: 6px;
    }

    h2 {
      font-size: 1.3rem;
      color: var(--text-main);
      margin-bottom: 10px;
    }

    p {
      margin-bottom: 12px;
    }

    .milestone-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 8px;
    }

    .stat-box {
      flex: 1 1 160px;
      background-color: var(--bg-soft);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      padding: 14px;
      color: var(--text-main);
    }

    .stat-value {
      font-size: 1.35rem;
      font-weight: 700;
      color: var(--bg-deep);
    }

    .stat-desc {
      font-size: 0.9rem;
      color: var(--text-muted);
    }

    .song-box {
      background-color: var(--bg-soft);
      border: 1px solid var(--border-soft);
      border-radius: 12px;
      padding: 16px;
      margin-top: 8px;
    }

    .song-title {
      font-weight: 700;
      font-size: 1.05rem;
      color: var(--bg-deep);
    }

    .song-artist {
      font-size: 0.94rem;
      color: var(--text-muted);
      margin-bottom: 12px;
    }

    audio {
      width: 100%;
      margin-bottom: 12px;
    }

    .quiz-option {
      display: block;
      width: 100%;
      text-align: left;
      background-color: var(--bg-soft);
      color: var(--text-main);
      border: 1px solid var(--border-soft);
      border-radius: 10px;
      padding: 11px 14px;
      margin-bottom: 8px;
      font-size: 0.95rem;
      cursor: pointer;
    }

    .quiz-option:hover {
      background-color: #c8dff5;
    }

    .quiz-option.selected {
      background-color: var(--bg-deep);
      color: var(--text-light);
      border-color: var(--bg-deep);
    }

    .feedback {
      background-color: var(--bg-soft);
      border-left: 4px solid var(--bg-deep);
      border-radius: 8px;
      padding: 10px 12px;
      margin-top: 6px;
      margin-bottom: 14px;
      font-size: 0.94rem;
      color: var(--text-main);
    }

    .flip-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-top: 10px;
    }

    @media (max-width: 520px) {
      .flip-grid {
        grid-template-columns: 1fr;
      }
    }

    .flip-card {
      background-color: transparent;
      min-height: 150px;
      cursor: pointer;
    }

    .flip-inner {
      position: relative;
      width: 100%;
      min-height: 150px;
      transition: transform 0.45s ease;
      transform-style: preserve-3d;
    }

    .flip-card.flipped .flip-inner {
      transform: rotateY(180deg);
    }

    .flip-face {
      position: absolute;
      inset: 0;
      backface-visibility: hidden;
      border-radius: 12px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      border: 1px solid var(--border-soft);
    }

    .flip-front {
      background-color: var(--bg-soft);
      color: var(--text-main);
      text-align: center;
    }

    .flip-front span {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin-top: 6px;
    }

    .flip-back {
      background-color: var(--bg-deep);
      color: var(--text-light);
      border-color: var(--bg-deep);
      transform: rotateY(180deg);
      font-size: 0.95rem;
    }

    .letter-box {
      background-color: #f7fbff;
      border: 1px solid var(--border-soft);
      border-radius: 14px;
      padding: 22px;
      color: var(--text-main);
    }

    .letter-box p {
      margin-bottom: 16px;
    }

    .letter-box p:last-child {
      margin-bottom: 0;
    }

    .nav-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 10px;
      margin-top: 18px;
      flex-wrap: wrap;
    }

    .progress-text {
      font-size: 0.88rem;
      color: var(--text-muted);
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="cover-box" id="cover">
      <div class="cover-date">March 25, 2026 — November 25, 2026</div>
      <h1 class="cover-title">For Mikyla B</h1>
      <p class="cover-sub">Eight months since March 25, 2026.</p>
      <button class="btn" id="startBtn" type="button">Open Step by Step</button>
    </div>

    <div class="step-section" id="step-1">
      <div class="card">
        <div class="section-label">Step 1 of 4 • Milestone &amp; Song</div>
        <h2>Eight Months Together</h2>
        <p>From March 25, 2026 to November 25, 2026, that is 8 months.</p>

        <div class="milestone-row">
          <div class="stat-box">
            <div class="stat-value">8 Months</div>
            <div class="stat-desc">March 25, 2026 to November 25, 2026</div>
          </div>
          <div class="stat-box">
            <div class="stat-value" id="dayCount">245 Days</div>
            <div class="stat-desc">Span from start date to November 25, 2026</div>
          </div>
        </div>

        <!-- EDIT HERE: Replace the audio src or song link below -->
        <div class="song-box">
          <div class="song-title">She Chose Me</div>
          <div class="song-artist">Bruno Major</div>
          <audio controls preload="none">
            <source src="" type="audio/mpeg" />
          </audio>
          <a
            class="btn btn-secondary"
            href="https://open.spotify.com/search/She%20Chose%20Me%20Bruno%20Major"
            target="_blank"
            rel="noopener noreferrer"
          >
            Open Song Link
          </a>
        </div>

        <div class="nav-bar">
          <span class="progress-text">Step 1 of 4</span>
          <button class="btn" type="button" onclick="goToStep(2)">Next: Quiz</button>
        </div>
      </div>
    </div>

    <div class="step-section" id="step-2">
      <div class="card">
        <div class="section-label">Step 2 of 4 • Quick Quiz</div>
        <h2>Four Questions</h2>
        <p>Pick an answer for each question.</p>
        <div id="quizContainer"></div>
        <div class="nav-bar">
          <button class="btn btn-secondary" type="button" onclick="goToStep(1)">Back</button>
          <button class="btn" type="button" onclick="goToStep(3)">Next: Flip Cards</button>
        </div>
      </div>
    </div>

    <div class="step-section" id="step-3">
      <div class="card">
        <div class="section-label">Step 3 of 4 • Eight Cards</div>
        <h2>Tap Each Card to Flip</h2>
        <p>Eight short lines for eight months.</p>
        <div class="flip-grid" id="flipGrid"></div>
        <div class="nav-bar">
          <button class="btn btn-secondary" type="button" onclick="goToStep(2)">Back</button>
          <button class="btn" type="button" onclick="goToStep(4)">Next: Message</button>
        </div>
      </div>
    </div>

    <div class="step-section" id="step-4">
      <div class="card">
        <div class="section-label">Step 4 of 4 • Message</div>
        <h2>For You, Ga</h2>
        <div class="letter-box">
          <p>Mikyla B,</p>
          <p>If you're reading this, I want you to know that I thought about ending this.</p>
          <p>Ending my fear, ending my doubts, ending my habit of pushing people away. Because in these 8 months, you taught me that it's okay to stay. It's okay to be loved.</p>
          <p>I don't want to end us. I want to start another month with you, and another, and another.</p>
          <p>Sorry na agad, pero you're stuck with me. Hindi ka na makakatakas.</p>
          <p>Happy 8th Monthsarry, Ga. Live your life to the fullest, my love. I'll be right here, cheering for you, loving you quietly and loudly at the same time. I love you so much.</p>
        </div>
        <div class="nav-bar">
          <button class="btn btn-secondary" type="button" onclick="goToStep(3)">Back</button>
          <button class="btn" type="button" onclick="goToStep(1)">Back to Start</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    // EDIT HERE: Update the 4 quiz questions, options, and feedback messages
    const quizData = [
      {
        question: "1. When did we start counting from?",
        options: ["March 25, 2026", "April 25, 2026", "March 15, 2026"],
        feedback: "March 25, 2026 is the exact start date."
      },
      {
        question: "2. How many months are we marking on November 25, 2026?",
        options: ["6 months", "8 months", "10 months"],
        feedback: "Eight months from March 25, 2026 to November 25, 2026."
      },
      {
        question: "3. Which song is on this page?",
        options: ["She Chose Me — Bruno Major", "Nothing — Bruno Major", "Easily — Bruno Major"],
        feedback: "She Chose Me by Bruno Major stays right here."
      },
      {
        question: "4. Am I planning to leave or stay?",
        options: ["Leave", "Stay", "Still unsure"],
        feedback: "I am staying with you, Ga."
      }
    ];

    // EDIT HERE: Update the 8 flip card front labels and back lines
    const flipCardsData = [
      {
        front: "Card 01",
        back: "Simula March 25, 2026, ikaw na yung paborito kong update sa araw ko."
      },
      {
        front: "Card 02",
        back: "\"She Chose Me\" hits different when the person in the song actually chose you."
      },
      {
        front: "Card 03",
        back: "Ang sarap sa pakiramdam ng hindi kailangang magtago o magpanggap sa'yo."
      },
      {
        front: "Card 04",
        back: "Kahit simpleng kwento lang yan, nakikinig ako at naaalala ko yan."
      },
      {
        front: "Card 05",
        back: "You make staying feel easy on days when everything else feels heavy."
      },
      {
        front: "Card 06",
        back: "Walong buwan na tayo, Ga, at gusto ko pa ring ikaw ang kasama sa susunod."
      },
      {
        front: "Card 07",
        back: "I still root for you in every room you walk into, even when you do not see it."
      },
      {
        front: "Card 08",
        back: "Happy 8th monthsary, Mikyla B. Nandito pa rin ako, same person, mas sigurado sa'yo."
      }
    ];

    const startDate = new Date("2026-03-25T00:00:00");
    const targetDate = new Date("2026-11-25T00:00:00");
    const diffDays = Math.round((targetDate - startDate) / (1000 * 60 * 60 * 24));
    document.getElementById("dayCount").textContent = diffDays + " Days";

    function goToStep(stepNumber) {
      document.querySelectorAll(".step-section").forEach((el) => {
        el.classList.remove("active");
      });
      const target = document.getElementById("step-" + stepNumber);
      if (target) {
        target.classList.add("active");
        target.scrollIntoView({ behavior: "smooth", block: "start" });
      }
    }

    document.getElementById("startBtn").addEventListener("click", () => {
      goToStep(1);
    });

    const quizContainer = document.getElementById("quizContainer");
    quizData.forEach((item, qIndex) => {
      const qBlock = document.createElement("div");
      const qTitle = document.createElement("p");
      qTitle.innerHTML = "<strong>" + item.question + "</strong>";
      qBlock.appendChild(qTitle);

      const feedbackEl = document.createElement("div");
      feedbackEl.className = "feedback";
      feedbackEl.style.display = "none";

      item.options.forEach((optText) => {
        const btn = document.createElement("button");
        btn.type = "button";
        btn.className = "quiz-option";
        btn.textContent = optText;
        btn.addEventListener("click", () => {
          qBlock.querySelectorAll(".quiz-option").forEach((b) => b.classList.remove("selected"));
          btn.classList.add("selected");
          feedbackEl.textContent = item.feedback;
          feedbackEl.style.display = "block";
        });
        qBlock.appendChild(btn);
      });

      qBlock.appendChild(feedbackEl);
      quizContainer.appendChild(qBlock);
    });

    const flipGrid = document.getElementById("flipGrid");
    flipCardsData.forEach((card) => {
      const cardEl = document.createElement("div");
      cardEl.className = "flip-card";

      const innerEl = document.createElement("div");
      innerEl.className = "flip-inner";

      const frontEl = document.createElement("div");
      frontEl.className = "flip-face flip-front";
      frontEl.innerHTML = "<strong>" + card.front + "</strong><span>Tap to flip</span>";

      const backEl = document.createElement("div");
      backEl.className = "flip-face flip-back";
      backEl.textContent = card.back;

      innerEl.appendChild(frontEl);
      innerEl.appendChild(backEl);
      cardEl.appendChild(innerEl);

      cardEl.addEventListener("click", () => {
        cardEl.classList.toggle("flipped");
      });

      flipGrid.appendChild(cardEl);
    });
  </script>
</body>
</html>
